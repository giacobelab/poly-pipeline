{
  "_comment": "Everything PolyCI builds, pinned. Change a ref or a baseline release here, in a pull request; CI does the rest. Level users and counts come from each lab's lab.json; set 'users'/'levels' on a lab only if it has no lab.json (or to override it). See README.md.",
  "builder": {
    "repo": "ruffm/buildroot-builder2",
    "ref": "94bf9379dee63439e677d96f9d3ac68403e8473e",
    "buildroot_version": "2025.02.15"
  },
  "v86": {
    "npm_version": "0.5.473",
