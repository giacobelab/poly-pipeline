      "baseline": "filesystem",
      "self_test": "test.sh",
      "boot_test": "generic",
      "server": true
    },
    "polylinux-basic": {
      "title": "PolyLinux Basic",
      "repo": "ruffm/polylinux-basic",
      "ref": "3a69ead6da26fb3de540d6e88290faf8cfc14f3f",
      "subdir": ".",
      "baseline": "basic",
      "boot_test": "generic", 
      "server": true
    },
    "polylinux-networking": {
      "title": "PolyLinux Networking",
